<Window x:Class="TranslucentTodo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TranslucentTodo.Converters"
        Title="Translucent To-Do"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        MinWidth="240" MinHeight="160"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:UrgencyBrushConverter x:Key="UrgencyBrush"/>

        <!-- Menus with icons; the destructive action is red, as in Apple's menus. -->
        <ContextMenu x:Key="ActiveMenu" x:Shared="False">
            <MenuItem Header="Edit" Click="Edit_Click">
                <MenuItem.Icon><TextBlock Text="&#xE70F;"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Delete" Click="Delete_Click" Foreground="{StaticResource DeadlineBrush}">
                <MenuItem.Icon><TextBlock Text="&#xE74D;"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="UpcomingMenu" x:Shared="False">
            <MenuItem Header="Show now" Click="ShowNow_Click">
                <MenuItem.Icon><TextBlock Text="&#xE8A9;"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Edit" Click="Edit_Click">
                <MenuItem.Icon><TextBlock Text="&#xE70F;"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Delete" Click="Delete_Click" Foreground="{StaticResource DeadlineBrush}">
                <MenuItem.Icon><TextBlock Text="&#xE74D;"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform/>
                            </Grid.RenderTransform>
                            <Border x:Name="Hover" Background="#1F2FB36B" CornerRadius="7" Opacity="0"/>
                            <ContentPresenter Margin="8,3" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.93" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.93" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource Spring}"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource Spring}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An active task card. Double-click anywhere inside the border to check it off. -->
        <DataTemplate x:Key="ActiveTaskTemplate">
            <!-- Root and Card transforms are created per card in TaskRoot_Loaded: template-declared ones are frozen. -->
            <Grid x:Name="Root" Margin="0,0,0,6" Loaded="TaskRoot_Loaded">
                <Grid x:Name="Card" RenderTransformOrigin="0.5,0.5"
                      MouseLeftButtonDown="Card_MouseLeftButtonDown"
                      MouseLeftButtonUp="Card_Release" MouseLeave="Card_Release"
                      ContextMenu="{StaticResource ActiveMenu}"
                      ToolTip="Double-click to complete · Right-click for more"
                      ToolTipService.InitialShowDelay="1500" ToolTipService.Placement="Bottom">
                    <!-- Fill shades from translucent white to bright red as the deadline approaches. -->
                    <Border CornerRadius="11" BorderThickness="1" BorderBrush="{StaticResource CardBorder}"
                            Background="{Binding Urgency, Converter={StaticResource UrgencyBrush}}"/>
                    <!-- Hover brightens via a separate sheen layer so it never fights the deadline tint. -->
                    <Border x:Name="Sheen" CornerRadius="11" Background="White" Opacity="0" IsHitTestVisible="False"/>
                    <!-- A brief green wash confirms the completion before the card leaves. -->
                    <Border x:Name="Glow" CornerRadius="11" Background="{StaticResource AccentBrush}" Opacity="0" IsHitTestVisible="False"/>
                    <!-- Marks the task currently loaded into the add bar for editing. -->
                    <Border x:Name="EditRing" CornerRadius="11" BorderThickness="1.5" BorderBrush="{StaticResource AccentBrush}"
                            Opacity="0" IsHitTestVisible="False"/>
                    <Grid Margin="12,11,12,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="Check" Width="18" Height="18" Margin="0,1,10,0" VerticalAlignment="Top"
                              Background="Transparent" Cursor="Hand" RenderTransformOrigin="0.5,0.5"
                              MouseLeftButtonDown="Check_MouseLeftButtonDown" ToolTip="Complete"
                            ToolTipService.InitialShowDelay="900">
                            <Grid.RenderTransform>
                                <ScaleTransform/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Circle" StrokeThickness="1.5">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#00FFFFFF"/>
                                </Ellipse.Fill>
                                <Ellipse.Stroke>
                                    <SolidColorBrush Color="#663C3C43"/>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <!-- Hovering the circle previews the action: a darker ring and a ghost checkmark. -->
                            <Ellipse x:Name="HoverRing" StrokeThickness="1.5" Stroke="#B33C3C43" Opacity="0"/>
                            <Path x:Name="Ghost" Data="M 4.6,9.3 L 7.8,12.4 L 13.5,5.9" Stroke="#8C3C3C43" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0"/>
                            <Path x:Name="Tick" Data="M 4.6,9.3 L 7.8,12.4 L 13.5,5.9"
                                  Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  StrokeDashArray="8 8" StrokeDashOffset="8" Opacity="0"/>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Text="{Binding Title}" TextWrapping="Wrap" FontSize="13.5"/>
                            <WrapPanel x:Name="Badges" Margin="0,2,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="Badge" Text="{Binding RecurrenceText, StringFormat='↻ {0}'}"
                                           FontFamily="{StaticResource SmallFont}" FontSize="11" Margin="0,0,10,0"
                                           Visibility="Collapsed" Foreground="{StaticResource TextSecondary}"/>
                                <StackPanel x:Name="DeadlineBadge" Orientation="Horizontal" Visibility="Collapsed">
                                    <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,1,4,0"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding DeadlineText}" FontFamily="{StaticResource SmallFont}"
                                               FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRecurring}" Value="True">
                    <Setter TargetName="Badge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Badges" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasDeadline}" Value="True">
                    <Setter TargetName="DeadlineBadge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Badges" Property="Visibility" Value="Visible"/>
                </DataTrigger>

                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity"
                                                 To="0.14" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>

                <Trigger SourceName="Check" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetName="Ghost" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="Ghost" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>

                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="EditRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="EditRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough"/>
                    <!-- The hover preview gives way to the real checkmark. -->
                    <Setter TargetName="Ghost" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="HoverRing" Property="Visibility" Value="Collapsed"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="CheckStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                 To="0.16" Duration="0:0:0.18"/>
                                <ColorAnimation Storyboard.TargetName="Circle" To="{StaticResource AccentColor}"
                                                Duration="0:0:0.16"
                                                Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"/>
                                <ColorAnimation Storyboard.TargetName="Circle" To="{StaticResource AccentColor}"
                                                Duration="0:0:0.16"
                                                Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)"/>
                                <!-- Hidden until checked: a zero-length round cap would otherwise show as a dot. -->
                                <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity"
                                                 To="1" BeginTime="0:0:0.08" Duration="0"/>
                                <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="StrokeDashOffset"
                                                 To="0" BeginTime="0:0:0.08" Duration="0:0:0.24"
                                                 EasingFunction="{StaticResource Spring}"/>
                                <!-- A tap carries no momentum, so the pop settles without overshoot. -->
                                <DoubleAnimation Storyboard.TargetName="Check"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.82" To="1" Duration="0:0:0.3"
                                                 EasingFunction="{StaticResource Spring}"/>
                                <DoubleAnimation Storyboard.TargetName="Check"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.82" To="1" Duration="0:0:0.3"
                                                 EasingFunction="{StaticResource Spring}"/>
                                <DoubleAnimation Storyboard.TargetName="TitleText" Storyboard.TargetProperty="Opacity"
                                                 To="0.45" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="CheckStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A recurring task that is waiting for its next due day. -->
        <DataTemplate x:Key="UpcomingTaskTemplate">
            <Grid x:Name="Item" Margin="0,0,0,5" ContextMenu="{StaticResource UpcomingMenu}"
                  ToolTip="Right-click to show now, edit or delete" ToolTipService.InitialShowDelay="1500"
                  ToolTipService.Placement="Bottom">
                <Grid.Triggers>
                    <!-- Fades in when a checked-off recurring task arrives here. -->
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <Border Background="#1AFFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="11"/>
                <Border x:Name="Sheen" Background="White" CornerRadius="11" Opacity="0" IsHitTestVisible="False"/>
                <Grid Margin="12,7,12,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="12.5"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding RecurrenceText, StringFormat='↻ {0}'}"
                                   FontFamily="{StaticResource SmallFont}" FontSize="10.5"
                                   Margin="0,1,0,0" Foreground="{StaticResource TextFaint}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding NextDueText}" FontFamily="{StaticResource SmallFont}"
                               FontSize="11" Margin="8,1,0,0" VerticalAlignment="Top"
                               Foreground="{StaticResource TextSecondary}"/>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Item" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!--
        The shell is invisible at rest. Its 1% white fill keeps the whole window clickable
        (fully transparent pixels of a layered window let clicks fall through, which would make
        dragging and resizing impossible). A faint outline fades in only while hovered.
    -->
    <Border x:Name="Shell" BorderThickness="1" CornerRadius="14" RenderTransformOrigin="0.5,0.5">
        <Border.Background>
            <SolidColorBrush x:Name="ShellFill" Color="#03FFFFFF"/>
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush x:Name="ShellEdge" Color="#00FFFFFF"/>
        </Border.BorderBrush>
        <Border.RenderTransform>
            <ScaleTransform/>
        </Border.RenderTransform>
        <Grid Margin="10,8,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: drag to move -->
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="3,0,0,0">
                    <TextBlock Text="To-Do" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock FontFamily="{StaticResource SmallFont}" FontSize="11.5" Margin="0,1,0,0"
                               Foreground="{StaticResource TextSecondary}">
                        <Run x:Name="DateRun"/><Run x:Name="CountRun"/>
                    </TextBlock>
                </StackPanel>
                <!-- Window controls only appear while the pointer is over the widget. -->
                <StackPanel x:Name="WindowButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                            Opacity="0">
                    <Button Style="{StaticResource IconButton}" ToolTip="Minimize to tray" Click="Minimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Close to tray" Click="Close_Click" Margin="2,0,0,0">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Tasks, then the add bar right under the latest task, then upcoming recurring tasks -->
            <!-- The wheel is handled in code: smooth, eased scrolling with a soft rubber-band at the ends. -->
            <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="0,10,-6,0" Padding="0,0,6,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="Scroller_PreviewMouseWheel">
                <StackPanel x:Name="ListStack">
                    <StackPanel.RenderTransform>
                        <TranslateTransform/>
                    </StackPanel.RenderTransform>
                    <ItemsControl x:Name="ActiveList" ItemTemplate="{StaticResource ActiveTaskTemplate}"/>

                    <!-- Shown when nothing is left on the list. -->
                    <Grid x:Name="EmptyHost" Visibility="Collapsed" ClipToBounds="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,14">
                            <TextBlock Text="&#xE930;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Margin="0,1,8,0"/>
                            <TextBlock Text="All clear" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Add / edit bar -->
                    <Grid x:Name="AddBar">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewTaskBox" Style="{StaticResource GlassTextBox}" KeyDown="NewTaskBox_KeyDown"
                                 TextChanged="NewTaskBox_TextChanged"/>
                        <TextBlock x:Name="Placeholder" Text="Add a task…" IsHitTestVisible="False" FontSize="13"
                                   Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                        <ToggleButton x:Name="DeadlineToggle" Grid.Column="1" Style="{StaticResource IconButton}" Width="30" Height="30"
                                      Margin="6,0,0,0" ToolTip="Deadline" Checked="DeadlineToggle_Changed" Unchecked="DeadlineToggle_Changed">
                            <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                        </ToggleButton>
                        <ToggleButton x:Name="RepeatToggle" Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30"
                                      Margin="2,0,0,0" ToolTip="Repeat" Checked="RepeatToggle_Changed" Unchecked="RepeatToggle_Changed">
                            <TextBlock Text="&#xE8EE;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                        </ToggleButton>
                        <!-- Visible only while editing: slides open next to Save. -->
                        <Button x:Name="CancelEditButton" Grid.Column="3" Style="{StaticResource IconButton}" Width="0" Height="30"
                                Margin="2,0,0,0" ToolTip="Cancel editing (Esc)" Click="CancelEdit_Click" Opacity="0"
                                Visibility="Collapsed">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                        </Button>
                        <Button x:Name="SubmitButton" Grid.Column="4" Style="{StaticResource IconButton}" Width="30" Height="30"
                                Margin="2,0,0,0" ToolTip="Add task (Enter)" Click="Submit_Click">
                            <TextBlock x:Name="SubmitGlyph" Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                        </Button>
                    </Grid>

                    <!--
                        Pickers, their sub-options, the calendar and the undo bar each live in a clipping host
                        whose height is animated, so they unroll from the add bar instead of popping in and
                        shoving the list below. Spacing sits inside the host so nothing snaps at the end.
                    -->

                    <!-- Deadline picker -->
                    <Grid x:Name="DeadlineHost" Visibility="Collapsed" ClipToBounds="True">
                        <Border Margin="0,6,0,0" Padding="10,9,5,5" Background="{StaticResource GlassFill}"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <Grid Margin="1,0,5,7">
                                    <TextBlock Text="Deadline" FontFamily="{StaticResource SmallFont}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="DeadlineSummary" HorizontalAlignment="Right" FontFamily="{StaticResource SmallFont}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                </Grid>
                                <WrapPanel>
                                    <RadioButton x:Name="DueNone" GroupName="Due" Style="{StaticResource RadioChip}" Content="None"
                                                 IsChecked="True" Checked="DeadlineKind_Checked"/>
                                    <RadioButton x:Name="DueToday" GroupName="Due" Style="{StaticResource RadioChip}" Content="Today"
                                                 Checked="DeadlineKind_Checked"/>
                                    <RadioButton x:Name="DueTomorrow" GroupName="Due" Style="{StaticResource RadioChip}" Content="Tomorrow"
                                                 Checked="DeadlineKind_Checked"/>
                                    <RadioButton x:Name="DueWeek" GroupName="Due" Style="{StaticResource RadioChip}" Content="In a week"
                                                 Checked="DeadlineKind_Checked"/>
                                    <RadioButton x:Name="DuePick" GroupName="Due" Style="{StaticResource RadioChip}" Content="Pick date…"
                                                 Checked="DeadlineKind_Checked"/>
                                </WrapPanel>
                                <Grid x:Name="CalendarHost" Visibility="Collapsed" ClipToBounds="True">
                                    <Calendar x:Name="DeadlineCalendar" Style="{StaticResource GlassCalendar}" Margin="0,4,5,2"
                                              SelectedDatesChanged="DeadlineCalendar_SelectedDatesChanged"
                                              DisplayDateChanged="DeadlineCalendar_DisplayDateChanged"
                                              DisplayModeChanged="DeadlineCalendar_DisplayModeChanged"
                                              PreviewMouseUp="DeadlineCalendar_PreviewMouseUp"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Repeat picker -->
                    <Grid x:Name="RepeatHost" Visibility="Collapsed" ClipToBounds="True">
                        <Border Margin="0,6,0,0" Padding="10,9,5,5" Background="{StaticResource GlassFill}"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <Grid Margin="1,0,5,7">
                                    <TextBlock Text="Repeat" FontFamily="{StaticResource SmallFont}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="RepeatSummary" HorizontalAlignment="Right" FontFamily="{StaticResource SmallFont}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                </Grid>
                                <WrapPanel>
                                    <RadioButton x:Name="RepNone" GroupName="Kind" Style="{StaticResource RadioChip}" Content="Never"
                                                 IsChecked="True" Checked="RepeatKind_Checked"/>
                                    <RadioButton x:Name="RepDaily" GroupName="Kind" Style="{StaticResource RadioChip}" Content="Daily"
                                                 Checked="RepeatKind_Checked"/>
                                    <RadioButton x:Name="RepWeekly" GroupName="Kind" Style="{StaticResource RadioChip}" Content="Weekly"
                                                 Checked="RepeatKind_Checked"/>
                                    <RadioButton x:Name="RepMonthly" GroupName="Kind" Style="{StaticResource RadioChip}" Content="Monthly"
                                                 Checked="RepeatKind_Checked"/>
                                    <RadioButton x:Name="RepEvery" GroupName="Kind" Style="{StaticResource RadioChip}" Content="Every N days"
                                                 Checked="RepeatKind_Checked"/>
                                </WrapPanel>
                                <Grid x:Name="WeekdayPanel" Visibility="Collapsed" ClipToBounds="True">
                                    <WrapPanel x:Name="WeekdayChips" Margin="0,2,0,0" ToggleButton.Checked="RepeatDetail_Changed"
                                               ToggleButton.Unchecked="RepeatDetail_Changed">
                                        <ToggleButton Style="{StaticResource Chip}" Padding="8,4" Tag="1" Content="Mon"/>
                                        <ToggleButton Style="{StaticResource Chip}" Padding="8,4" Tag="2" Content="Tue"/>
                                        <ToggleButton Style="{StaticResource Chip}" Padding="8,4" Tag="3" Content="Wed"/>
                                        <ToggleButton Style="{StaticResource Chip}" Padding="8,4" Tag="4" Content="Thu"/>
                                        <ToggleButton Style="{StaticResource Chip}" Padding="8,4" Tag="5" Content="Fri"/>
                                        <ToggleButton Style="{StaticResource Chip}" Padding="8,4" Tag="6" Content="Sat"/>
                                        <ToggleButton Style="{StaticResource Chip}" Padding="8,4" Tag="0" Content="Sun"/>
                                    </WrapPanel>
                                </Grid>
                                <Grid x:Name="MonthlyPanel" Visibility="Collapsed" ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal" Margin="1,2,0,5">
                                        <TextBlock Text="On day" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="MonthDayBox" Style="{StaticResource GlassTextBox}" Width="46" Margin="8,0,0,0"
                                                 Padding="6,3" FontSize="12" MaxLength="2" TextChanged="RepeatDetail_Changed"/>
                                        <TextBlock Text="of each month" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="IntervalPanel" Visibility="Collapsed" ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal" Margin="1,2,0,5">
                                        <TextBlock Text="Every" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="IntervalBox" Style="{StaticResource GlassTextBox}" Width="46" Margin="8,0,0,0"
                                                 Padding="6,3" FontSize="12" MaxLength="3" TextChanged="RepeatDetail_Changed"/>
                                        <TextBlock Text="days" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Undo bar: unrolls from under the add bar, beneath the list -->
                    <Grid x:Name="ToastHost" Visibility="Collapsed" ClipToBounds="True">
                        <Border x:Name="UndoToast" Margin="0,6,0,0" Background="#4DFFFFFF"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <Grid Margin="12,6,4,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="UndoText" FontSize="12.5" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Style="{StaticResource TextButton}" Click="Undo_Click"
                                            ToolTip="Ctrl+Z">
                                        <TextBlock>Undo <Run Text="Ctrl+Z" FontWeight="Normal" Foreground="{StaticResource TextFaint}" FontSize="10.5"/></TextBlock>
                                    </Button>
                                </Grid>
                                <Rectangle x:Name="UndoProgress" Height="2" Margin="12,0,12,0" VerticalAlignment="Bottom"
                                           RadiusX="1" RadiusY="1" Fill="{StaticResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="UpcomingSection" Margin="0,12,0,0">
                        <ToggleButton x:Name="UpcomingToggle" Cursor="Hand" Focusable="False" Margin="0,0,0,6"
                                      HorizontalAlignment="Left" RenderTransformOrigin="0,0.5"
                                      Checked="UpcomingToggle_Changed" Unchecked="UpcomingToggle_Changed">
                            <ToggleButton.RenderTransform>
                                <ScaleTransform/>
                            </ToggleButton.RenderTransform>
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="3,2,8,2">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="UpcomingChevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                           FontSize="9" VerticalAlignment="Center" Margin="0,1,6,0"
                                           RenderTransformOrigin="0.5,0.5" Foreground="{StaticResource TextSecondary}">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="UpcomingHeader" Text="Upcoming" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ItemsControl x:Name="UpcomingList" ItemTemplate="{StaticResource UpcomingTaskTemplate}"
                                      Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
